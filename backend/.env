# --- Server Configuration ---
PORT=8081
ZIVRO_CORS_ORIGINS=http://localhost:5173

# --- Database Configuration (Customized for your Port 3307) ---
ZIVRO_DB_URL=jdbc:mysql://localhost:3306/zivro?useSSL=true&serverTimezone=UTC
ZIVRO_DB_USER=root
ZIVRO_DB_PASSWORD=root

# --- Security & JWT ---
# Must be at least 32 characters long
ZIVRO_JWT_SECRET=zivro_local_secret_key_1234567890_must_be_32_chars
ZIVRO_JWT_EXPIRATION_MS=86400000

# --- Admin Bootstrap (Creates default admin on startup) ---
ZIVRO_BOOTSTRAP_ADMIN_EMAIL=admin@zivro.com
ZIVRO_BOOTSTRAP_ADMIN_PASSWORD=admin
ZIVRO_BOOTSTRAP_ADMIN_NAME="Super Admin"

# --- Optional: Cloudinary Image Storage (Leave false for local disk fallback) ---
ZIVRO_CLOUDINARY_ENABLED=false
# ZIVRO_CLOUDINARY_CLOUD_NAME=your_cloud_name
# ZIVRO_CLOUDINARY_API_KEY=your_api_key
# ZIVRO_CLOUDINARY_API_SECRET=your_api_secret
# ZIVRO_CLOUDINARY_FOLDER=zivro

# --- Optional: Razorpay Payments (Leave false to bypass payment gates locally) ---
ZIVRO_RAZORPAY_ENABLED=false
# ZIVRO_RAZORPAY_KEY_ID=your_test_key_id
# ZIVRO_RAZORPAY_KEY_SECRET=your_test_key_secret
# ZIVRO_RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
ZIVRO_RAZORPAY_DEPOSIT_FRACTION=0.25
ZIVRO_RAZORPAY_REQUIRE_DEPOSIT_BEFORE_ACCEPT=false